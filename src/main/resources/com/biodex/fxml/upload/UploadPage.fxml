<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.upload.UploadController"
            prefHeight="600.0" prefWidth="800.0">

    <!-- main logic -->
    <VBox alignment="CENTER" prefHeight="400" prefWidth="800" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12" prefWidth="800" styleClass="card" style="-fx-padding: 15;">
            <Label text="Upload Files" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="lightModeToggle" text="Light Mode"/>
        </HBox>

        <!-- main section -->
        <VBox spacing="15" prefHeight="550" prefWidth="800" style="-fx-padding: 30"
              AnchorPane.bottomAnchor="40"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              VBox.vgrow="ALWAYS">

            <!-- dropSection -->
            <VBox fx:id="dropSection"
                  alignment="CENTER"
                  VBox.vgrow="ALWAYS"
                  spacing="5"
                  styleClass="drop-zone">

                <Label text="Drag and Drop Files" styleClass="muted"/>
                <Label text="or" styleClass="muted"/>
                <Button fx:id="browseButton"
                        text="Click to Browse"
                        mnemonicParsing="false"
                        onAction="#handleButtonAction"/>
            </VBox>

            <Label text="Selected Files:" styleClass="field-label"/>
            <ListView fx:id="uploadList" prefHeight="50"/>

            <!-- file specs section -->
            <VBox spacing="5" styleClass="card">
                <Label text="File Requirements:" styleClass="section-title"/>
                <Label text="Max File Size: 10MB"/>
                <Label text="Accepted Format: JPEG, JPG, GIF, PNG"/>
                <Label text="Max Files: 5"/>
            </VBox>
        </VBox>
    </VBox>
</AnchorPane>
