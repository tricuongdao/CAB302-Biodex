<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Identify a pest: photo drop zone on the left, matches and sighting form on the right. -->
<?import javafx.scene.control.ListView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.identify.IdentifyPestController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Identify a pest" styleClass="screen-title"/>
                    <Label text="Step 1 of 3 - add photos of what you found" styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <fx:include source="../common/ThemeSwitchView.fxml"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <!-- Photo drop zone. -->
                <VBox HBox.hgrow="ALWAYS" spacing="12">
                    <VBox fx:id="dropZone" styleClass="drop-zone" alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS">
                        <ImageView fx:id="photoPreview" fitWidth="260" fitHeight="180" preserveRatio="true"
                                   visible="false" managed="false"/>
                        <Label fx:id="promptIcon" text="?" styleClass="muted"/>
                        <Label fx:id="promptTitle" text="Drop photos here" styleClass="section-title"/>
                        <Label text="Up to 5 photos, 10 MB each. Clear, side-on shots identify fastest."
                               styleClass="muted" wrapText="true" textAlignment="CENTER" maxWidth="280"/>
                        <Region prefHeight="6"/>
                        <HBox spacing="10">
                            <Button text="Browse files" onAction="#onBrowseFiles" mnemonicParsing="false"/>
                            <Button text="Use camera" styleClass="outline-button" mnemonicParsing="false"/>
                        </HBox>
                        <Label fx:id="messageLabel" styleClass="muted" wrapText="true" textAlignment="CENTER"
                               maxWidth="280" visible="false" managed="false"/>
                    </VBox>
                    <VBox spacing="10">
                        <Label text="Uploaded Photos" styleClass="field-label"/>
                        <ListView fx:id="photoListView" prefHeight="100" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Matches + sighting details. -->
                <VBox prefWidth="360" minWidth="360" spacing="12">
                    <Label fx:id="contextLabel" styleClass="tag-chip" wrapText="true" visible="false" managed="false"/>
                    <VBox fx:id="matchesBox" styleClass="card" spacing="10">
                        <Label text="Possible matches" styleClass="section-title"/>
                        <Label fx:id="matchesPlaceholder" text="Upload a photo to see possible matches."
                               styleClass="muted" wrapText="true"/>
                    </VBox>


                    <VBox styleClass="card" spacing="10">
                        <Label text="Where &amp; when" styleClass="section-title"/>
                        <GridPane hgap="12" vgap="6">
                            <Label text="WHERE" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="whereField" promptText="Kedron Brook, near the park" maxWidth="Infinity"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                            <Label text="SUBURB" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="suburbCombo" promptText="Type or choose a suburb" maxWidth="Infinity"
                                      visibleRowCount="10" editable="true"
                                      GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                            <Label text="WHEN" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                <DatePicker fx:id="whenDatePicker" promptText="Pick a date" maxWidth="Infinity"
                                            HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="whenTimeCombo" promptText="Time" prefWidth="104" visibleRowCount="8"/>
                            </HBox>
                            <Label text="COUNT" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="countCombo" promptText="How many?" maxWidth="Infinity"
                                      GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                            <Label text="NOTES" styleClass="field-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                            <TextArea fx:id="notesField" promptText="Hear the calling after rain..." prefRowCount="3" maxWidth="Infinity"
                                      GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                        </GridPane>
                        <Label fx:id="reportMessage" styleClass="muted" wrapText="true" visible="false" managed="false"/>
                        <Hyperlink fx:id="viewSightingsLink" text="View local sightings for this species"
                                   onAction="#onViewSightings" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Footer actions. -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Back" styleClass="outline-button" onAction="#onBackToHeatMap" mnemonicParsing="false"/>
                <Button fx:id="submitButton" text="Submit report" onAction="#onSubmitReport" mnemonicParsing="false"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
