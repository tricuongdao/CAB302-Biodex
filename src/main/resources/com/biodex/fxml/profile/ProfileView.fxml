<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Profile & settings: identity card on the left, account actions on the right. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.profile.ProfileController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Profile &amp; settings" styleClass="screen-title"/>
                    <Label text="johncitizen@example.com" styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Edit profile" styleClass="outline-button" mnemonicParsing="false"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <!-- Left: identity and preferences. -->
                <VBox styleClass="card" prefWidth="420" minWidth="420" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane styleClass="avatar" prefWidth="44" prefHeight="44" minWidth="44" minHeight="44">
                            <Label text="JD" styleClass="avatar-initials"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="John Citizen" styleClass="section-title"/>
                            <Label text="johncitizen@example.com" styleClass="muted"/>
                        </VBox>
                    </HBox>
                    <Region styleClass="divider"/>

                    <Label text="APPEARANCE" styleClass="field-label"/>
                    <HBox spacing="8">
                        <Button text="Light" styleClass="chip" mnemonicParsing="false"/>
                        <Button text="Dark" styleClass="chip" mnemonicParsing="false"/>
                        <Button text="Auto" styleClass="chip chip-selected" mnemonicParsing="false"/>
                    </HBox>

                    <Label text="REGION" styleClass="field-label"/>
                    <Label text="Brisbane QLD"/>

                    <Label text="VERIFIED EMAIL" styleClass="field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="johncitizen@example.com"/>
                        <Label text="Verified" styleClass="threat-chip threat-low"/>
                    </HBox>
                </VBox>

                <!-- Right: account actions. -->
                <VBox HBox.hgrow="ALWAYS" spacing="12">
                    <VBox styleClass="card" spacing="10">
                        <Label text="Account" styleClass="section-title"/>
                        <Button text="Change password" styleClass="outline-button" maxWidth="Infinity" mnemonicParsing="false"/>
                        <Button text="Export my records" styleClass="outline-button" maxWidth="Infinity" mnemonicParsing="false"/>
                        <Button text="Sign out" styleClass="danger-button" maxWidth="Infinity"
                                onAction="#onSignOut" mnemonicParsing="false"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>

