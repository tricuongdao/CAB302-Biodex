<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<!-- Light / Dark / Auto theme switcher, included in the top bar of every screen. -->
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="com.biodex.controller.common.ThemeSwitchController"
      alignment="CENTER_RIGHT" spacing="10">
    <Hyperlink fx:id="lightLink" text="Light" styleClass="theme-link" onAction="#onLight"/>
    <Hyperlink text="Dark" styleClass="theme-link" onAction="#onDark"/>
    <Label text="Auto" styleClass="theme-muted"/>
</HBox>
