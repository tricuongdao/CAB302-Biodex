<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.biodex.controller.common.ThemeSwitchController"
      alignment="CENTER_LEFT" spacing="10">
    <Label text="Theme" styleClass="theme-label"/>
    <ToggleButton fx:id="themeToggle" styleClass="theme-toggle" mnemonicParsing="false"
                  onAction="#onThemeToggle">
        <graphic>
            <StackPane styleClass="theme-toggle-track" mouseTransparent="true">
                <HBox alignment="CENTER" styleClass="theme-toggle-icons">
                    <Label text="☼" styleClass="theme-toggle-sun"/>
                    <Label text="☾" styleClass="theme-toggle-moon"/>
                </HBox>
                <Circle fx:id="toggleKnob" radius="10" styleClass="theme-toggle-knob"
                        StackPane.alignment="CENTER_LEFT"/>
            </StackPane>
        </graphic>
    </ToggleButton>
</HBox>
