<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Shared navigation rail used by every main screen via fx:include. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.biodex.controller.common.SidebarController"
      styleClass="sidebar" prefWidth="216" minWidth="216" spacing="4">

    <padding><Insets top="24" right="16" bottom="20" left="20"/></padding>

    <Label text="BIODEX" styleClass="logo"/>
    <Region prefHeight="22"/>

    <Button fx:id="heatMapLink" text="Heat map" styleClass="sidebar-link"
            maxWidth="Infinity" mnemonicParsing="false" onAction="#onHeatMap"/>
    <Button fx:id="identifyLink" text="Identify a pest" styleClass="sidebar-link"
            maxWidth="Infinity" mnemonicParsing="false" onAction="#onIdentifyPest"/>
    <Button fx:id="pestDetailsLink" text="Pest details" styleClass="sidebar-link"
            maxWidth="Infinity" mnemonicParsing="false" onAction="#onPestDetails"/>
    <Button fx:id="profileLink" text="Profile" styleClass="sidebar-link"
            maxWidth="Infinity" mnemonicParsing="false" onAction="#onProfile"/>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Signed-in user chip pinned to the bottom of the rail. -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <StackPane styleClass="avatar" prefWidth="34" prefHeight="34" minWidth="34" minHeight="34">
            <Label fx:id="userInitials" text="" styleClass="avatar-initials"/>
        </StackPane>
        <VBox spacing="1">
            <Label fx:id="username" text="" styleClass="screen-title"/>
            <Label text="Brisbane QLD" styleClass="sidebar-muted"/>
        </VBox>
    </HBox>
</VBox>
