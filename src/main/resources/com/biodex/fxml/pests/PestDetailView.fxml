<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Pest Detail screen: hosts SpeciesDetail (left) + LocalSightings (right) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.pests.PestDetailController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="scroll-pane">
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- Breadcrumb back to the search page. -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Hyperlink text="Back to search" styleClass="text-link" onAction="#onBackToPestDetails"/>
                            <Label fx:id="breadcrumbLabel" text="/ Loading..." styleClass="muted"/>
                        </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <!-- Left pane: SpeciesDetailController -->
                <fx:include source="SpeciesDetailView.fxml" fx:id="speciesDetail"/>

                <!-- Right pane: LocalSightingsController -->
                <fx:include source="LocalSightingsView.fxml" fx:id="localSightings"/>
            </HBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
