<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!-- Pest details: a live ALA species search feeding a grid of species cards. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.pests.PestDetailsController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- Top bar: title + search. -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Pest details" styleClass="screen-title"/>
                    <Label text="What's been seen in your area" styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search species or suburbs" prefWidth="240"/>
            </HBox>

            <!-- Card grid, rebuilt by the controller from live search results. -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="14">
                    <TilePane fx:id="cardsPane" hgap="14" vgap="14" prefColumns="3"/>

                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="countLabel" text="Loading species..." styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>

