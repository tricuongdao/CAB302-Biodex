<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<!-- Sign in: dark green brand panel on the left, form on the cream page. -->
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.biodex.controller.auth.LoginController"
      styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <!-- Brand panel: logo up top, the pitch and headline stats weighted to the bottom. -->
    <VBox fx:id="brandPanel" styleClass="brand-panel" prefWidth="380" minWidth="380" spacing="0">
        <padding><Insets top="36" right="36" bottom="36" left="36"/></padding>
        <Label text="BIODEX" styleClass="logo"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="Log an invasive species sighting in the field, and see what everyone else has found nearby."
               styleClass="brand-tagline" wrapText="true"/>
        <Region prefHeight="30"/>

        <VBox spacing="4">
            <Label text="1,224" styleClass="brand-stat-number"/>
            <Label text="sightings logged, some as recent as an hour ago" styleClass="brand-stat-label" wrapText="true"/>
        </VBox>
        <Region prefHeight="18"/>
        <VBox spacing="4">
            <Label text="62" styleClass="brand-stat-number"/>
            <Label text="species in the reference library" styleClass="brand-stat-label" wrapText="true"/>
        </VBox>
        <Region prefHeight="18"/>
        <VBox spacing="4">
            <Label text="South East QLD" styleClass="brand-stat-number"/>
            <Label text="the region the library covers" styleClass="brand-stat-label" wrapText="true"/>
        </VBox>
    </VBox>

    <!-- Sign-in form, optically centered between the theme switch and the bottom edge. -->
    <StackPane HBox.hgrow="ALWAYS">
        <VBox fx:id="formBox" maxWidth="360" spacing="0">
            <padding><Insets top="24" right="40" bottom="40" left="40"/></padding>

            <fx:include source="../common/ThemeSwitchView.fxml"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Sign in" styleClass="page-title"/>
            <Region prefHeight="6"/>
            <Label text="Use your email account." styleClass="muted"/>
            <Region prefHeight="26"/>

            <VBox spacing="6">
                <Label text="EMAIL" styleClass="field-label"/>
                <TextField fx:id="usernameOrEmailField" promptText="you@example.com"/>
            </VBox>
            <Region prefHeight="16"/>
            <VBox spacing="6">
                <Label text="PASSWORD" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="********"/>
            </VBox>
            <Region prefHeight="16"/>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <CheckBox text="Keep me signed in"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?" styleClass="text-link" onAction="#onForgotPassword"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

            <Region prefHeight="18"/>

            <Button fx:id="signInButton" text="Sign in" maxWidth="Infinity" onAction="#onSignIn"/>

            <Region prefHeight="14"/>

            <HBox alignment="CENTER" spacing="10" fillHeight="false">
                <Region prefWidth="80" styleClass="divider"/>
                <Label text="or" styleClass="muted"/>
                <Region prefWidth="80" styleClass="divider"/>
            </HBox>

            <Region prefHeight="14"/>

            <Button fx:id="googleSignInButton" styleClass="google-btn" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#onGoogleSignIn">
                <graphic>
                    <ImageView fitHeight="36" preserveRatio="true">
                        <Image url="@/com/biodex/images/google-signin.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Region prefHeight="10"/>

            <Button text="Create an account" styleClass="outline-button" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#onCreateAccount"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </StackPane>
</HBox>
