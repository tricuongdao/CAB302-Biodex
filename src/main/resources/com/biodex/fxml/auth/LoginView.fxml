<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<!-- Sign in: a single centered card on the page, no side panel. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.LoginController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <!-- Sign-in card, centered both ways. -->
    <VBox fx:id="formBox" styleClass="login-card" maxWidth="420" maxHeight="-Infinity" spacing="0">
        <VBox alignment="CENTER" spacing="6">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="Invasive Species Tracker" styleClass="muted"/>
        </VBox>

        <Region prefHeight="30"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Sign in" styleClass="page-title"/>
            <Label text="Use your email account." styleClass="muted"/>
        </VBox>

        <Region prefHeight="28"/>

        <VBox spacing="6">
            <Label text="EMAIL" styleClass="field-label"/>
            <TextField fx:id="usernameOrEmailField" promptText="you@example.com"/>
        </VBox>
        <Region prefHeight="16"/>
        <VBox spacing="6">
            <Label text="PASSWORD" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="********"/>
        </VBox>
        <Region prefHeight="16"/>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <CheckBox text="Keep me signed in"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Forgot password?" styleClass="text-link" onAction="#onForgotPassword"/>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

        <Region prefHeight="18"/>

        <Button fx:id="signInButton" text="Sign in" maxWidth="Infinity" onAction="#onSignIn"/>

        <Region prefHeight="14"/>

        <HBox alignment="CENTER" spacing="10" fillHeight="false">
            <Region prefWidth="80" styleClass="divider"/>
            <Label text="or" styleClass="muted"/>
            <Region prefWidth="80" styleClass="divider"/>
        </HBox>

        <Region prefHeight="14"/>

        <Button fx:id="googleSignInButton" styleClass="google-btn" maxWidth="Infinity"
                mnemonicParsing="false" onAction="#onGoogleSignIn">
            <graphic>
                <ImageView fitHeight="36" preserveRatio="true">
                    <Image url="@/com/biodex/images/google-signin.png"/>
                </ImageView>
            </graphic>
        </Button>

        <Region prefHeight="10"/>

        <Button text="Create an account" styleClass="outline-button" maxWidth="Infinity"
                mnemonicParsing="false" onAction="#onCreateAccount"/>
    </VBox>

    <!-- Theme switch floats in the top-right corner, off the card. -->
    <HBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" spacing="8"
          StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="18" right="24"/></padding>
        <fx:include source="../common/ThemeSwitchView.fxml"/>
    </HBox>
</StackPane>
