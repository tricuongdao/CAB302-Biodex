<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Account recovery: a single centered card on the page, matching the sign-in screen. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.ResetPasswordController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <VBox fx:id="formBox" styleClass="auth-card" maxWidth="420" maxHeight="-Infinity" spacing="0">
        <VBox alignment="CENTER" spacing="6">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="Invasive Species Tracker" styleClass="muted"/>
        </VBox>

        <Region prefHeight="30"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Choose a new password" styleClass="page-title"/>
            <Label text="Your password must contain at least 8 characters, including a letter and a number."
                   styleClass="muted" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <Region prefHeight="28"/>

        <VBox spacing="6">
            <Label text="NEW PASSWORD" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField" promptText="Enter a new password"/>
        </VBox>
        <Region prefHeight="16"/>
        <VBox spacing="6">
            <Label text="CONFIRM PASSWORD" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Enter the password again"
                           onAction="#onResetPassword"/>
        </VBox>

        <Label fx:id="errorLabel" text="" wrapText="true" managed="false" visible="false"
               styleClass="error-label"/>

        <Region prefHeight="18"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="resetButton" text="Reset password" maxWidth="Infinity"
                    HBox.hgrow="ALWAYS" onAction="#onResetPassword"/>

            <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24"
                               managed="false" visible="false"/>
        </HBox>

        <Region prefHeight="10"/>

        <HBox alignment="CENTER">
            <Hyperlink text="Cancel and return to sign in" styleClass="text-link" onAction="#onCancel"/>
        </HBox>
    </VBox>

    <!-- Theme switch floats in the top-right corner, off the card. -->
    <HBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" spacing="8"
          StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="18" right="24"/></padding>
        <fx:include source="../common/ThemeSwitchView.fxml"/>
    </HBox>
</StackPane>
