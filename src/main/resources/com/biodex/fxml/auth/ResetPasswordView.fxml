<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.ResetPasswordController"
           styleClass="auth-screen"
           prefWidth="1200"
           prefHeight="760">

    <VBox spacing="10">
        <padding>
            <Insets top="8" right="32" bottom="24" left="32"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="- Account recovery" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <fx:include source="../common/ThemeSwitchView.fxml"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox styleClass="card" maxWidth="420" spacing="12">
            <Label text="Choose a new password"
                   styleClass="page-title"/>

            <Label text="Your password must contain at least 8 characters, including a letter and a number."
                   styleClass="muted"
                   wrapText="true"/>

            <Label text="NEW PASSWORD" styleClass="field-label"/>

            <PasswordField fx:id="newPasswordField"
                           promptText="Enter a new password"/>

            <Label text="CONFIRM PASSWORD" styleClass="field-label"/>

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Enter the password again"
                           onAction="#onResetPassword"/>

            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   managed="false"
                   visible="false"
                   style="-fx-text-fill: #d9534f;"/>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="resetButton"
                        text="Reset password"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#onResetPassword"/>

                <ProgressIndicator fx:id="progressIndicator"
                                   prefWidth="24"
                                   prefHeight="24"
                                   managed="false"
                                   visible="false"/>
            </HBox>

            <HBox alignment="CENTER">
                <Hyperlink text="Cancel and return to sign in"
                           styleClass="text-link"
                           onAction="#onCancel"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>