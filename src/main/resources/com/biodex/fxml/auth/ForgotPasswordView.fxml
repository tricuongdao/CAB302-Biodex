<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Account recovery: one narrow card with the email reset flow. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.ForgotPasswordController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">
    <VBox spacing="10">
        <padding><Insets top="8" right="32" bottom="24" left="32"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="- Account recovery" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <fx:include source="../common/ThemeSwitchView.fxml"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox styleClass="card" maxWidth="420" spacing="12">
            <Label text="Reset your password" styleClass="page-title"/>
            <Label text="We email you a single-use link, valid for 30 minutes."
                   styleClass="muted" wrapText="true"/>

            <Label text="EMAIL" styleClass="field-label"/>
            <TextField promptText="you@example.com"/>

            <Button text="Send reset link" maxWidth="Infinity" onAction="#onSendResetLink"/>

            <HBox alignment="CENTER">
                <Hyperlink text="Back to sign in" styleClass="text-link" onAction="#onBackToLogin"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>
