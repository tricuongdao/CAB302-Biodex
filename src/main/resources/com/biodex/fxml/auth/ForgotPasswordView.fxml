<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Account recovery: a single centered card on the page, matching the sign-in screen. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.ForgotPasswordController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <VBox fx:id="formBox" styleClass="auth-card" maxWidth="420" maxHeight="-Infinity" spacing="0">
        <VBox alignment="CENTER" spacing="6">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="Invasive Species Tracker" styleClass="muted"/>
        </VBox>

        <Region prefHeight="30"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Reset your password" styleClass="page-title"/>
            <Label text="Enter your account email and we will send you a six-digit code. The code remains valid for 15 minutes."
                   styleClass="muted" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <Region prefHeight="28"/>

        <VBox spacing="6">
            <Label text="EMAIL" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" onAction="#onSendCode"/>
        </VBox>

        <Label fx:id="errorLabel" text="" wrapText="true" managed="false" visible="false"
               styleClass="error-label"/>

        <Region prefHeight="18"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="sendCodeButton" text="Send code" maxWidth="Infinity"
                    HBox.hgrow="ALWAYS" onAction="#onSendCode"/>

            <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24"
                               managed="false" visible="false"/>
        </HBox>

        <Region prefHeight="10"/>

        <HBox alignment="CENTER">
            <Hyperlink text="Back to sign in" styleClass="text-link" onAction="#onBackToLogin"/>
        </HBox>
    </VBox>

    <!-- Theme switch floats in the top-right corner, off the card. -->
    <HBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" spacing="8"
          StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="18" right="24"/></padding>
        <fx:include source="../common/ThemeSwitchView.fxml"/>
    </HBox>
</StackPane>
