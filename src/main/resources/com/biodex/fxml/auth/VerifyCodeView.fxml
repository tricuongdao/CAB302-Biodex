<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Account recovery: a single centered card on the page, matching the sign-in screen. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.VerifyCodeController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <VBox fx:id="formBox" styleClass="auth-card" maxWidth="420" maxHeight="-Infinity" spacing="0">
        <VBox alignment="CENTER" spacing="6">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="Invasive Species Tracker" styleClass="muted"/>
        </VBox>

        <Region prefHeight="30"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Enter verification code" styleClass="page-title"/>
            <Label fx:id="emailLabel" text="We sent a code to your email."
                   styleClass="muted" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <Region prefHeight="28"/>

        <VBox spacing="6">
            <Label text="VERIFICATION CODE" styleClass="field-label"/>
            <TextField fx:id="codeField" promptText="6-digit code" onAction="#onVerifyCode"/>
        </VBox>

        <Label fx:id="errorLabel" text="" wrapText="true" managed="false" visible="false"
               styleClass="error-label"/>

        <Region prefHeight="18"/>

        <Button fx:id="verifyButton" text="Verify code" maxWidth="Infinity" onAction="#onVerifyCode"/>

        <Region prefHeight="10"/>

        <HBox alignment="CENTER" spacing="8">
            <Hyperlink text="Request a new code" styleClass="text-link" onAction="#onRequestNewCode"/>
            <Label text="|" styleClass="muted"/>
            <Hyperlink text="Back to sign in" styleClass="text-link" onAction="#onBackToLogin"/>
        </HBox>
    </VBox>

    <!-- Theme switch floats in the top-right corner, off the card. -->
    <HBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" spacing="8"
          StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="18" right="24"/></padding>
        <fx:include source="../common/ThemeSwitchView.fxml"/>
    </HBox>
</StackPane>
