<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.VerifyCodeController"
           styleClass="auth-screen"
           prefWidth="1200"
           prefHeight="760">

    <VBox spacing="10" alignment="TOP_CENTER">
        <padding>
            <Insets top="8" right="32" bottom="24" left="32"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="- Account recovery" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <fx:include source="../common/ThemeSwitchView.fxml"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox styleClass="card" maxWidth="420" spacing="12">
            <Label text="Enter verification code"
                   styleClass="page-title"/>

            <Label fx:id="emailLabel"
                   text="We sent a code to your email."
                   styleClass="muted"
                   wrapText="true"/>

            <Label text="VERIFICATION CODE"
                   styleClass="field-label"/>

            <TextField fx:id="codeField"
                       promptText="6-digit code"
                       onAction="#onVerifyCode"/>

            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   managed="false"
                   visible="false"
                   style="-fx-text-fill: #d9534f;"/>

            <Button fx:id="verifyButton"
                    text="Verify code"
                    maxWidth="Infinity"
                    onAction="#onVerifyCode"/>

            <HBox alignment="CENTER" spacing="8">
                <Hyperlink text="Request a new code"
                           styleClass="text-link"
                           onAction="#onRequestNewCode"/>
            </HBox>

            <HBox alignment="CENTER">
                <Hyperlink text="Back to sign in"
                           styleClass="text-link"
                           onAction="#onBackToLogin"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>