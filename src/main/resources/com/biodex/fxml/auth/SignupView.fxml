<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Create account: a single centered card on the page, matching the sign-in screen. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.SignupController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">

    <VBox fx:id="formBox" styleClass="auth-card" maxWidth="420" maxHeight="-Infinity" spacing="0">
        <VBox alignment="CENTER" spacing="6">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="Invasive Species Tracker" styleClass="muted"/>
        </VBox>

        <Region prefHeight="30"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Create your account" styleClass="page-title"/>
            <Label text="One account for everything you find." styleClass="muted"/>
        </VBox>

        <Region prefHeight="28"/>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="DISPLAY NAME" styleClass="field-label"/>
                <TextField fx:id="displayNameField" promptText="Alex"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="USERNAME" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="alexc"/>
            </VBox>
        </HBox>
        <Region prefHeight="16"/>

        <VBox spacing="6">
            <Label text="EMAIL" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com"/>
        </VBox>
        <Region prefHeight="16"/>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="PASSWORD" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="********"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="CONFIRM PASSWORD" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="********"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

        <Region prefHeight="12"/>

        <!-- Live password checklist. -->
        <HBox spacing="8">
            <Label text="8+ characters" styleClass="check-pill"/>
            <Label text="a number" styleClass="check-pill"/>
            <Label text="an uppercase letter" styleClass="check-pill"/>
        </HBox>

        <Region prefHeight="12"/>

        <CheckBox text="My photos can appear on the closed map with my username" wrapText="true"/>

        <Region prefHeight="18"/>

        <Button fx:id="createAccountButton" text="Create account" maxWidth="Infinity" onAction="#onCreateAccount"/>

        <Region prefHeight="10"/>

        <HBox alignment="CENTER">
            <Hyperlink text="Already registered? Sign in" styleClass="text-link" onAction="#onBackToLogin"/>
        </HBox>
    </VBox>

    <!-- Theme switch floats in the top-right corner, off the card. -->
    <HBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" spacing="8"
          StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="18" right="24"/></padding>
        <fx:include source="../common/ThemeSwitchView.fxml"/>
    </HBox>
</StackPane>
