<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Create account: small wordmark top-left, one centred card with the form. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.biodex.controller.auth.SignupController"
           styleClass="auth-screen" prefWidth="1200" prefHeight="760">
    <VBox spacing="10">
        <padding><Insets top="8" right="32" bottom="24" left="32"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="BIODEX" styleClass="logo"/>
            <Label text="- Create account" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <fx:include source="../common/ThemeSwitchView.fxml"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox styleClass="card" maxWidth="640" spacing="12">
            <Label text="Create your account" styleClass="page-title"/>
            <Label text="One account for everything you find." styleClass="muted"/>

            <GridPane hgap="16" vgap="6">
                <Label text="DISPLAY NAME" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label text="USERNAME" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <TextField fx:id="displayNameField" promptText="Alex" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" promptText="alexc" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="EMAIL" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       GridPane.columnSpan="2"/>
                <TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity" GridPane.rowIndex="3"
                           GridPane.columnIndex="0" GridPane.columnSpan="2"/>

                <Label text="PASSWORD" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label text="CONFIRM PASSWORD" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <PasswordField fx:id="passwordField" promptText="********" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" promptText="********" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

            <!-- Live password checklist. -->
            <HBox spacing="8">
                <Label text="8+ characters" styleClass="check-pill"/>
                <Label text="a number" styleClass="check-pill"/>
                <Label text="an uppercase letter" styleClass="check-pill"/>
            </HBox>

            <CheckBox text="My photos can appear on the closed map with my username"/>

            <Button fx:id="createAccountButton" text="Create account" maxWidth="Infinity" onAction="#onCreateAccount"/>

            <HBox alignment="CENTER">
                <Hyperlink text="Already registered? Sign in" styleClass="text-link" onAction="#onBackToLogin"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>