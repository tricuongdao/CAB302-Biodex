<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<!-- Heat map: database-backed hotspots, filters, legend and selected-area details. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.heatmap.HeatMapController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Heat map" styleClass="screen-title"/>
                    <Label fx:id="summaryLabel" text="Loading saved sightings..." styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Map" styleClass="chip chip-selected" mouseTransparent="true"
                        focusTraversable="false" mnemonicParsing="false"/>
                <Button text="Clear filters" styleClass="ghost-button" onAction="#onClearFilters"
                        mnemonicParsing="false"/>
                <Button text="+ Report a sighting" onAction="#onReportSighting" mnemonicParsing="false"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="DATE" styleClass="field-label"/>
                <Button fx:id="last7DaysButton" text="Last 7 days" styleClass="chip"
                        onAction="#onLast7Days" mnemonicParsing="false"/>
                <Button fx:id="last30DaysButton" text="Last 30 days" styleClass="chip chip-selected"
                        onAction="#onLast30Days" mnemonicParsing="false"/>
                <Region prefWidth="8"/>
                <Label text="SPECIES" styleClass="field-label"/>
                <Button fx:id="caneToadButton" text="Cane Toad" styleClass="chip"
                        onAction="#onCaneToad" mnemonicParsing="false"/>
                <Button fx:id="fireAntButton" text="Fire Ant" styleClass="chip"
                        onAction="#onFireAnt" mnemonicParsing="false"/>
                <Button fx:id="waterHyacinthButton" text="Water Hyacinth" styleClass="chip"
                        onAction="#onWaterHyacinth" mnemonicParsing="false"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <StackPane styleClass="map-canvas" HBox.hgrow="ALWAYS">
                    <WebView fx:id="basemapView" minWidth="0" minHeight="0" prefWidth="600"/>
                    <Pane fx:id="hotspotLayer" pickOnBounds="false" maxWidth="Infinity" maxHeight="Infinity"/>

                    <Label fx:id="emptyStateLabel" text="No saved sightings yet."
                           styleClass="map-empty-state" visible="false" managed="false"
                           wrapText="true" maxWidth="280" mouseTransparent="true"/>

                    <ProgressIndicator fx:id="loadingIndicator" maxWidth="42" maxHeight="42" mouseTransparent="true"/>

                    <VBox styleClass="card,map-legend" maxWidth="210" maxHeight="-Infinity" mouseTransparent="true" spacing="6"
                          StackPane.alignment="BOTTOM_LEFT">
                        <StackPane.margin><Insets bottom="16" left="16"/></StackPane.margin>
                        <Label text="Sighting density" styleClass="section-title"/>
                        <Region prefWidth="120" styleClass="density-bar"/>
                        <HBox alignment="CENTER_LEFT" spacing="80">
                            <Label text="Low" styleClass="muted"/>
                            <Label text="High" styleClass="muted"/>
                        </HBox>
                    </VBox>
                </StackPane>

                <VBox prefWidth="280" minWidth="280" spacing="12">
                    <VBox styleClass="card" spacing="10">
                        <Label fx:id="selectedAreaLabel" text="Select a hot spot" styleClass="section-title"/>
                        <Label text="SPECIES FOUND HERE" styleClass="field-label"/>
                        <Label fx:id="selectedSpeciesLabel"
                               text="Click a numbered marker to inspect its sightings." wrapText="true"/>
                        <Label fx:id="selectedDateLabel" styleClass="muted" wrapText="true"/>
                        <Region styleClass="divider"/>
                        <Label text="LATEST DESCRIPTION" styleClass="field-label"/>
                        <Label fx:id="selectedDescriptionLabel" styleClass="muted" wrapText="true"/>
                    </VBox>
                    <Button text="Report here" maxWidth="Infinity" onAction="#onReportSighting"
                            mnemonicParsing="false"/>
                </VBox>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="basemapStatusLabel" text="Loading map..." styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button text="Reset map" onAction="#onResetMap" mnemonicParsing="false"/>
                <Button text="Retry map" onAction="#onRetryMap" mnemonicParsing="false"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
