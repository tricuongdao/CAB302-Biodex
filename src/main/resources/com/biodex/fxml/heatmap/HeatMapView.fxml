<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Heat map: full-width map canvas with density blobs, filters and a side panel. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biodex.controller.heatmap.HeatMapController"
            prefWidth="1200" prefHeight="760">

    <left>
        <fx:include source="../common/SidebarView.fxml" fx:id="sidebar"/>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- Top bar: title, view filters, report action. -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Heat map" styleClass="screen-title"/>
                    <Label text="1,224 sightings - showing 10 hot spots - South East QLD" styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Map" styleClass="chip chip-selected" mnemonicParsing="false"/>
                <Button text="List" styleClass="chip" mnemonicParsing="false"/>
                <Button text="Clear filters" styleClass="ghost-button" mnemonicParsing="false"/>
                <Button text="+ Report a sighting" onAction="#onReportSighting" mnemonicParsing="false"/>
            </HBox>

            <!-- Filter chips row. -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button text="Last 7 days" styleClass="chip chip-selected" mnemonicParsing="false"/>
                <Button text="Last 30 days" styleClass="chip" mnemonicParsing="false"/>
                <Button text="Amphibians" styleClass="chip" mnemonicParsing="false"/>
                <Button text="Insects" styleClass="chip" mnemonicParsing="false"/>
                <Button text="Flora" styleClass="chip" mnemonicParsing="false"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <!-- Stylised map area with density blobs and a legend. -->
                <StackPane styleClass="map-canvas" HBox.hgrow="ALWAYS">
                    <Circle radius="95" styleClass="blob-high" translateX="130" translateY="-60" mouseTransparent="true"/>
                    <Circle radius="70" styleClass="blob-mid" translateX="-160" translateY="40" mouseTransparent="true"/>
                    <Circle radius="55" styleClass="blob-mid" translateX="60" translateY="140" mouseTransparent="true"/>
                    <Circle radius="45" styleClass="blob-low" translateX="-90" translateY="-130" mouseTransparent="true"/>
                    <Circle radius="35" styleClass="blob-low" translateX="230" translateY="110" mouseTransparent="true"/>

                    <VBox styleClass="card" maxWidth="210" spacing="6" alignment="BOTTOM_LEFT">
                        <StackPane.margin><Insets bottom="16" left="16"/></StackPane.margin>
                        <Label text="Density" styleClass="section-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Region prefWidth="120" styleClass="density-bar"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="80">
                            <Label text="Low" styleClass="muted"/>
                            <Label text="High" styleClass="muted"/>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- Side panel: what has been seen near the selected spot. -->
                <VBox prefWidth="280" minWidth="280" spacing="12">
                    <VBox styleClass="card" spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Kedron Brook" styleClass="section-title"/>
                        </HBox>
                        <Label text="SPECIES FOUND HERE" styleClass="field-label"/>
                        <HBox spacing="6">
                            <Button text="Cane toad" styleClass="chip chip-selected" mnemonicParsing="false"/>
                            <Button text="Fire ant" styleClass="chip" mnemonicParsing="false"/>
                        </HBox>
                        <Region prefHeight="4"/>
                        <Label text="MOST RECENT" styleClass="field-label"/>
                        <VBox spacing="2">
                            <Label text="Cane toad" styleClass="section-title"/>
                            <Label text="1 hour ago - Kedron Brook" styleClass="muted"/>
                        </VBox>
                        <Region styleClass="divider"/>
                        <VBox spacing="2">
                            <Label text="Fire ant nest" styleClass="section-title"/>
                            <Label text="2 days ago - Gordon Park" styleClass="muted"/>
                        </VBox>
                        <Region styleClass="divider"/>
                        <VBox spacing="2">
                            <Label text="Indian myna" styleClass="section-title"/>
                            <Label text="1 week ago - Wooloowin" styleClass="muted"/>
                        </VBox>
                        <Hyperlink text="Show all 42 as a list" styleClass="text-link"/>
                    </VBox>
                    <Button text="Report here" maxWidth="Infinity" onAction="#onReportSighting" mnemonicParsing="false"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
